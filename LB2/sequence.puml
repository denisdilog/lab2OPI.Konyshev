@startuml
actor "Користувач" as User
participant ":Система" as Sys
participant ":QuizService" as Quiz
participant ":Profile" as Prof

User -> Sys : Надати відповідь на квіз
activate Sys

Sys -> Quiz : checkAnswer(відповідь)
activate Quiz
Quiz --> Sys : результат (true/false)
deactivate Quiz

alt відповідь правильна (UC-03)
    Sys -> Prof : updatePoints(10)
    activate Prof
    Prof --> Sys : успішно
    deactivate Prof
    Sys --> User : "Правильно! +10 балів"
else відповідь неправильна
    Sys --> User : "Неправильно. Спробуйте інший факт"
end

deactivate Sys
@enduml