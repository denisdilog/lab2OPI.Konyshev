@startuml
left to right direction
skinparam packageStyle rectangle

actor "Користувач" as User
actor "Адміністратор" as Admin

rectangle "Система 'Fact & Quiz'" {
  usecase "Перегляд стрічки фактів" as UC01
  usecase "Проходження квізу" as UC02
  usecase "Отримання балів" as UC03
  usecase "Перегляд профілю/історії" as UC04
  usecase "Автентифікація (API)" as UC05
  usecase "Участь у батлі" as UC06
  usecase "Соціальна взаємодія" as UC07
  usecase "Управління системою" as UC08
}

User --> UC01
User --> UC04
User --> UC05
User --> UC06
User --> UC07

Admin --|> User 
Admin --> UC08

UC01 <.. UC02 : <<extend>>
UC02 ..> UC03 : <<include>>

@enduml